{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Jwt": {
      "Issuer": "",
      "Audience": "",
      "AccessTokenLifetimeMinutes": 60,
      "RoleClaimType": "roles",
      "UserIdClaimType": "sub"
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Database": {
    "CommandTimeoutSeconds": 30,
    "EnableSensitiveDataLogging": false
  }
}
