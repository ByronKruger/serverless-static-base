<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Pinned so restores do not depend on whichever feeds a given machine happens to
    have registered.

    CoffeegCommon is the team's private Azure Artifacts feed. It is listed here so
    the address lives with the repo, but disabled by default: without credentials
    every package lookup falls through to it and restores crawl. Enable it (and
    authenticate with the Azure Artifacts Credential Provider) when you need a
    package from it.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="CoffeegCommon" value="https://pkgs.dev.azure.com/krugb/beverages/_packaging/CoffeegCommon/nuget/v3/index.json" />
  </packageSources>
  <disabledPackageSources>
    <add key="CoffeegCommon" value="true" />
  </disabledPackageSources>
</configuration>
