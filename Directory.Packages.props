<Project>

  <!--
    Central Package Management: every PackageReference version lives here so the library
    and its test project can never drift apart, and so a consumer can read one file to see
    what versions this library was built and tested against.

    Some entries are pinned but unreferenced on purpose. Microsoft.EntityFrameworkCore.Design
    is what a consumer adds for `dotnet ef`; Mvc.Testing and EntityFrameworkCore.InMemory are
    what pipeline-level coverage would need if D-0010s follow-up restores it. Pinning them
    here keeps that cheap and keeps the version band consistent.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Framework (pinned to the installed 9.0 SDK band)">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="9.0.20" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.20" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.20" />
    <!-- Matches the version Microsoft.AspNetCore.Authentication.JwtBearer 9.0.20 resolves to. -->
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.19.2" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="9.0.20" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.20" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.20" />
  </ItemGroup>

  <ItemGroup Label="Mapping and validation (Docs/ARCHITECTURE.md locks)">
    <!-- 16.x is the patched line for GHSA-rvv3-g6hj-g44x. AutoMapper 15+ is commercially
         licensed, free below a revenue threshold that this project sits under - see Docs/DECISIONS.md D-0003. -->
    <PackageVersion Include="AutoMapper" Version="16.2.0" />
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup Label="Test stack">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.20" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.20" />
  </ItemGroup>

</Project>
